#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
while IFS= read -r name; do [[ -z "$name" ]] || unset "$name"; done \
  < <(git rev-parse --local-env-vars 2>/dev/null || true)
T="$(mktemp -d "${TMPDIR:-/tmp}/workflow.XXXXXX")"
trap 'rm -rf -- "$T"' EXIT
mkdir "$T/bin"
export PATH="$T/bin:$PATH" WORKFLOW_EVENT_LOG="$T/events" BUN_FAIL_ON=""
: > "$WORKFLOW_EVENT_LOG"

fail() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
expect_fail() {
  local label=$1 repo=$2
  shift 2
  if (cd "$repo" && "$@") >"$T/error" 2>&1; then
    fail "$label unexpectedly succeeded"
  fi
}
new_repo() {
  local n=$1 remote="$T/$1-origin.git" seed="$T/$1-seed" repo="$T/$1-work"
  git init --bare "$remote" >/dev/null 2>&1
  git --git-dir="$remote" symbolic-ref HEAD refs/heads/main
  git init --initial-branch=main "$seed" >/dev/null 2>&1
  git -C "$seed" config user.name test
  git -C "$seed" config user.email test@example
  printf 'base\n' > "$seed/README.md"
  git -C "$seed" add README.md
  git -C "$seed" commit -m base >/dev/null 2>&1
  git -C "$seed" remote add origin "$remote"
  git -C "$seed" push -u origin main >/dev/null 2>&1
  git clone "$remote" "$repo" >/dev/null 2>&1
  git -C "$repo" config user.name test
  git -C "$repo" config user.email test@example
  printf '%s\n' "$repo"
}
fixture() {
  local repo=$1
  mkdir -p "$repo/scripts" "$repo/.githooks"
  for s in start-task check finish-task install-hooks session-context; do
    cp "$ROOT/scripts/$s" "$repo/scripts/$s"
    chmod +x "$repo/scripts/$s"
  done
  cp "$ROOT/.githooks/pre-commit" "$ROOT/.githooks/pre-push" "$repo/.githooks/"
  chmod +x "$repo/.githooks/pre-commit" "$repo/.githooks/pre-push"
  # Keep checks in disposable fixtures from recursively running this suite.
  printf '#!/usr/bin/env bash\nexit 0\n' > "$repo/scripts/test-workflow"
  chmod +x "$repo/scripts/test-workflow"
  git -C "$repo" add scripts .githooks
  git -C "$repo" commit --no-verify -m fixture >/dev/null 2>&1
  git -C "$repo" push origin main >/dev/null 2>&1
}
start_task() {
  local repo=$1 slug=$2
  (cd "$repo" && "$repo/scripts/start-task" "$slug") > "$T/output" 2>&1
}

cat > "$T/bin/bun" <<'EOF'
#!/usr/bin/env bash
printf 'bun %s\n' "$*" >>"${WORKFLOW_EVENT_LOG:?}"
[[ -n ${BUN_FAIL_ON:-} && "$*" == "$BUN_FAIL_ON" ]] && exit 90
exit 0
EOF
cat > "$T/bin/gh" <<'EOF'
#!/usr/bin/env bash
printf 'gh %s\n' "$*" >>"${WORKFLOW_EVENT_LOG:?}"
if [[ $1 == pr && $2 == create || ${WORKFLOW_EXISTING_PR:-} == 1 ]]; then
  printf 'https://example.test/pr/1\n'
fi
exit 0
EOF
chmod +x "$T/bin/bun" "$T/bin/gh"

# A clean checkout starts from origin/main and creates a codex branch.
repo=$(new_repo start)
fixture "$repo"
start_task "$repo" smoke
[[ $(git -C "$repo" branch --show-current) == codex/smoke ]] || fail 'start-task did not create codex/smoke'
[[ $(git -C "$repo" rev-parse HEAD) == $(git -C "$repo" rev-parse origin/main) ]] || fail 'branch was not based on origin/main'

# Advance the remote to prove the next task pulls fresh main.
git -C "$T/start-seed" pull --ff-only origin main >/dev/null 2>&1
printf 'new upstream\n' > "$T/start-seed/upstream.txt"
git -C "$T/start-seed" add upstream.txt
git -C "$T/start-seed" commit -m upstream >/dev/null 2>&1
git -C "$T/start-seed" push origin main >/dev/null 2>&1
start_task "$repo" fresh
[[ -f $repo/upstream.txt ]] || fail 'start-task did not pull new upstream work'

# A dirty tree is preserved and cannot be switched or branched.
repo=$(new_repo dirty)
fixture "$repo"
before=$(git -C "$repo" hash-object "$repo/README.md")
printf 'uncommitted\n' >> "$repo/README.md"
dirty=$(git -C "$repo" hash-object "$repo/README.md")
expect_fail 'dirty start-task' "$repo" "$repo/scripts/start-task" dirty
[[ $(git -C "$repo" branch --show-current) == main ]] || fail 'dirty start-task changed branches'
[[ $(git -C "$repo" hash-object "$repo/README.md") == "$dirty" && "$dirty" != "$before" ]] || fail 'dirty start-task changed worktree content'

# Both repository hooks reject work directly on main.
repo=$(new_repo main-hook)
fixture "$repo"
(cd "$repo" && "$repo/scripts/install-hooks") >/dev/null
printf 'blocked\n' > "$repo/blocked.txt"
git -C "$repo" add blocked.txt
expect_fail 'main pre-commit' "$repo" git commit -m blocked
git -C "$repo" commit --no-verify -m fixture-main >/dev/null 2>&1
before=$(git -C "$repo" ls-remote origin refs/heads/main | awk '{print $1}')
expect_fail 'main pre-push' "$repo" git push origin main
[[ $(git -C "$repo" ls-remote origin refs/heads/main | awk '{print $1}') == "$before" ]] || fail 'main pre-push changed remote main'

# A failed deterministic check prevents both the push and gh PR operation.
repo=$(new_repo finish-failure)
fixture "$repo"
start_task "$repo" failure
printf 'task\n' > "$repo/task.txt"
git -C "$repo" add task.txt
git -C "$repo" commit -m task >/dev/null 2>&1
body="$T/body"
printf 'review\n' > "$body"
: > "$WORKFLOW_EVENT_LOG"
expect_fail 'finish-task validation failure' "$repo" env BUN_FAIL_ON='run build' "$repo/scripts/finish-task" --title Failure --body-file "$body"
git -C "$repo" ls-remote --exit-code --heads origin codex/failure >/dev/null 2>&1 && fail 'failed validation pushed task branch'
grep -Eq '^(push|gh) ' "$WORKFLOW_EVENT_LOG" && fail 'failed validation reached push or PR creation'
grep -Fxq 'bun run build' "$WORKFLOW_EVENT_LOG" || fail 'validation did not reach the requested build'

# Successful validation publishes the branch and opens a PR; retries reuse it.
: > "$WORKFLOW_EVENT_LOG"
(cd "$repo" && ./scripts/finish-task --title Success --body-file "$body") > "$T/output" 2>&1
[[ $(git -C "$repo" ls-remote origin refs/heads/codex/failure | awk '{print $1}') == $(git -C "$repo" rev-parse HEAD) ]] || fail 'successful finish did not push HEAD'
grep -q '^gh pr create ' "$WORKFLOW_EVENT_LOG" || fail 'successful finish did not open a PR'
: > "$WORKFLOW_EVENT_LOG"
(cd "$repo" && WORKFLOW_EXISTING_PR=1 ./scripts/finish-task --title Success --body-file "$body") > "$T/output" 2>&1
grep -q '^gh pr create ' "$WORKFLOW_EVENT_LOG" && fail 'retry created a duplicate PR'
grep -q '^gh pr edit ' "$WORKFLOW_EVENT_LOG" || fail 'retry did not update existing PR'

# No origin: starting works locally, while finish-task refuses PR delivery.
repo=$(new_repo local)
fixture "$repo"
git -C "$repo" remote remove origin
start_task "$repo" offline
printf 'offline work\n' > "$repo/offline.txt"
git -C "$repo" add offline.txt
git -C "$repo" commit -m 'docs: offline work' >/dev/null 2>&1
: > "$WORKFLOW_EVENT_LOG"
expect_fail 'offline finish' "$repo" ./scripts/finish-task --title Offline --body-file "$body"
grep -q 'An origin remote is required' "$T/error" || fail 'offline finish did not explain missing origin'
grep -q '^gh ' "$WORKFLOW_EVENT_LOG" && fail 'offline finish contacted GitHub'

# Existing configured hooks are never replaced.
git -C "$repo" config core.hooksPath custom-hooks
expect_fail 'existing hooks' "$repo" ./scripts/install-hooks
[[ $(git -C "$repo" config core.hooksPath) == custom-hooks ]] || fail 'hook installer replaced existing configuration'

# Detached and non-task branches cannot commit.
git -C "$repo" config core.hooksPath .githooks
git -C "$repo" switch --detach >/dev/null 2>&1
expect_fail 'detached pre-commit' "$repo" ./.githooks/pre-commit
git -C "$repo" switch --create other >/dev/null 2>&1
expect_fail 'non-task pre-commit' "$repo" ./.githooks/pre-commit

# A configured but unreachable origin must not fall back to a local branch.
git -C "$repo" remote add origin "$T/missing-origin.git"
expect_fail 'unreachable origin' "$repo" ./scripts/start-task must-fetch
[[ $(git -C "$repo" branch --show-current) == other ]] || fail 'failed fetch switched branches'

# Dirty task checkouts cannot finish or push; preserve the user's edits.
repo=$(new_repo dirty-finish)
fixture "$repo"
start_task "$repo" dirty-finish
printf 'committed\n' > "$repo/task.txt"
git -C "$repo" add task.txt
git -C "$repo" commit -m 'test: fixture' >/dev/null 2>&1
printf 'keep this\n' >> "$repo/task.txt"
expect_fail 'dirty finish' "$repo" ./scripts/finish-task --title Dirty --body-file "$body"
expect_fail 'dirty push' "$repo" git push origin codex/dirty-finish
grep -q 'keep this' "$repo/task.txt" || fail 'dirty task data was lost'

printf 'workflow smoke tests passed\n'
