#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if [[ $# != 1 || ! $1 =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo 'Usage: ./scripts/start-task <lowercase-hyphenated-slug>' >&2
  exit 1
fi
branch="codex/$1"
if [[ -n $(git status --porcelain) ]]; then
  echo 'Preserve or finish existing changes before starting a task.' >&2
  exit 1
fi
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo 'Create the initial project commit before starting a task.' >&2
  exit 1
fi
if git show-ref --verify --quiet "refs/heads/$branch"; then
  echo "Branch already exists: $branch. Continue that task instead of recreating it." >&2
  exit 1
fi
./scripts/install-hooks
if git remote | grep -Fxq origin; then
  git fetch origin main
  if ! git merge-base --is-ancestor HEAD origin/main; then
    echo 'Current checkout has unpublished/unmerged commits. Finish or reconcile them before starting from origin/main.' >&2
    exit 1
  fi
  git switch --create "$branch" origin/main
else
  echo 'Local-only mode: creating task branch from current committed HEAD.'
  git switch --create "$branch"
fi
