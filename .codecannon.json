{
    "ammo": [
      {
        "id": "componentStyle",
        "extension": "module.scss",
        "body": ["@import '../../../styling/helpers';\n", ".${FILENAME} {\n\n}"]
      },
      {
        "id": "proxyComponentStyle",
        "extension": "module.scss",
        "body": ["@import '../../styling/helpers';\n", ".${FILENAME} {\n\n}"]
      },
      {
        "id": "componentIndex",
        "extension": "ts",
        "name": "index",
        "body": ["export * from './${FILENAME}';\n"]
      },
      {
        "id": "componentReact",
        "extension": "tsx",
        "body": [
          "import $ from './${FILENAME}.module.scss';\n",
          "interface iProps {\n}\n",
          "export const ${COMPONENT_NAME}: React.FC<iProps> = ({",
          "}) => {",
          "    return <>${COMPONENT_NAME}</>;",
          "};\n"
        ]
      },
      {
        "id": "componentReactView",
        "extension": "tsx",
        "body": [
          "import $ from './${FILENAME}.module.scss';\n",
          "export const ${COMPONENT_NAME}: React.FC = () => {",
          "    return (",
          "        <div>",
          "            <h1>${COMPONENT_NAME}</h1>",
          "        </div>",
          "    );",
          "};\n",
          "export default ${COMPONENT_NAME};\n"
        ]
      },
      {
        "id": "viewStyle",
        "extension": "module.scss",
        "body": ["@import '../../styling/helpers';\n", ".${FILENAME} {\n\n}"]
      },
      {
        "id": "proxyViewStyle",
        "extension": "module.scss",
        "body": ["@import '../../styling/helpers';\n", ".${FILENAME} {\n\n}"]
      },
      {
        "id": "model",
        "extension": "ts",
        "body": [
          "export interface i${COMPONENT_NAME} {",
          "    key: string;",
          "}\n"
        ]
      },
      {
        "id": "updateComponentIndex",
        "extension": "ts",
        "name": "index",
        "body": ["export * from './${FILENAME}';\n"]
      },
      {
        "id": "updateModelIndex",
        "extension": "ts",
        "name": "index",
        "body": ["export * from './${FILENAME}';\n"]
      },
      {
        "id": "updateViewIndex",
        "extension": "ts",
        "name": "index",
        "body": ["export * from './${FILENAME}';\n"]
      }
    ],
    "cannons": [
      {
        "aftermath": ["updateComponentIndex"],
        "ammo": ["componentStyle", "componentIndex", "componentReact"],
        "description": "Creates an Atom",
        "id": "createAtomComponent",
