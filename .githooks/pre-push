#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
head="$(git rev-parse HEAD)"
branch="$(git symbolic-ref --quiet --short HEAD || true)"
validate=false
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ $remote_ref == refs/heads/main ]]; then
    echo 'Direct pushes to main are blocked; use ./scripts/finish-task to open a PR.' >&2
    exit 1
  fi
  if [[ $local_sha =~ ^0+$ ]]; then
    continue
  fi
  if [[ $branch != codex/?* || $local_ref != "refs/heads/$branch" || $local_sha != "$head" || $remote_ref != "refs/heads/$branch" ]]; then
    echo 'Push the checked-out codex/ branch under its own name so the exact contents can be validated.' >&2
    exit 1
  fi
  validate=true
done
if [[ $validate == true ]]; then
  if [[ -n $(git status --porcelain) ]]; then
    echo 'Commit all task changes before pushing.' >&2
    exit 1
  fi
  ./scripts/check
  if [[ $(git rev-parse HEAD) != "$head" || $(git symbolic-ref --quiet --short HEAD) != "$branch" || -n $(git status --porcelain) ]]; then
    echo 'Checkout changed during validation; review and retry.' >&2
    exit 1
  fi
fi
